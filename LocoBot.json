    {
      "parameters": {
        "jsCode": "const input =$('If2').first().json.arrival_datetime\n\n\nconst months = {\n  January: \"01\",\n  February: \"02\",\n  March: \"03\",\n  April: \"04\",\n  May: \"05\",\n  June: \"06\",\n  July: \"07\",\n  August: \"08\",\n  September: \"09\",\n  October: \"10\",\n  November: \"11\",\n  December: \"12\"\n};\n\nconst parts = input.split(\"-\");\n\nconst day = parts[0].padStart(2, \"0\");\nconst month = months[parts[1]];\nconst year = parts[2];\n\nlet hour = parseInt(parts[3]);\nconst minute = parts[4];\nconst period = parts[5];\n\nif (period === \"PM\" && hour !== 12) {\n  hour += 12;\n}\n\nif (period === \"AM\" && hour === 12) {\n  hour = 0;\n}\n\nhour = String(hour).padStart(2, \"0\");\n\nconst iso =\n`${year}-${month}-${day}T${hour}:${minute}:00+05:30`;\n\nconst desiredArrival =\nnew Date(iso);\n\nconst etaMinutes =\n$input.first().json.routes[0].summary.travelTimeInSeconds / 60;\n\nconst now =\nnew Date();\n\nconst projectedArrival =\nnew Date(\n  now.getTime() + etaMinutes * 60000\n);\n\nconst thresholdTime =\nnew Date(\n  desiredArrival.getTime() - 5 * 60000\n);\n\nconst shouldAlert =\nprojectedArrival >= thresholdTime;\n\nfunction formatIST(date) {\n\n  return date.toLocaleString(\n    \"en-IN\",\n    {\n      timeZone: \"Asia/Kolkata\",\n\n      year: \"numeric\",\n      month: \"2-digit\",\n      day: \"2-digit\",\n\n      hour: \"2-digit\",\n      minute: \"2-digit\",\n      second: \"2-digit\",\n\n      hour12: false\n    }\n  );\n\n}\n\nreturn [{ \n  asd:iso,\n  sads:now,\n  eta_minutes:\n    Math.round(etaMinutes),\n\n  should_alert:\n    shouldAlert,\n\n  current_time_ist:\n    formatIST(now),\n\n  desired_arrival_ist:\n    formatIST(desiredArrival),\n\n  projected_arrival_ist:\n    formatIST(projectedArrival),\n\n  threshold_time_ist:\n    formatIST(thresholdTime)\n\n}];"
      },
